{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "ignore": ["dist", "coverage", ".wrangler", "worker-configuration.d.ts"] },
	"organizeImports": { "enabled": true },
	"formatter": { "enabled": true, "indentStyle": "tab", "indentWidth": 2, "lineWidth": 100 },
	"javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": { "noDefaultExport": "error", "useImportType": "error" },
			"suspicious": { "noExplicitAny": "error", "noConsole": "error" }
		}
	},
	"overrides": [
		{
			"include": ["src/infrastructure/observability/diagnostics.ts"],
			"linter": { "rules": { "suspicious": { "noConsole": "off" } } }
		},
		{
			"include": ["*.config.ts", "src/index.ts"],
			"linter": { "rules": { "style": { "noDefaultExport": "off" } } }
		}
	]
}
