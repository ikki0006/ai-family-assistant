{
	"name": "ai-family-assistant",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.11.0",
	"engines": {
		"node": ">=22.22.3 <23",
		"pnpm": "10.11.0"
	},
	"scripts": {
		"preinstall": "node scripts/require-pnpm.mjs",
		"dev": "wrangler dev",
		"build": "wrangler deploy --dry-run --outdir dist",
		"deploy": "wrangler deploy --no-bundle dist/index.js",
		"preview": "wrangler dev --no-bundle dist/index.js",
		"check:lint": "biome lint . --error-on-warnings && pnpm check:complexity",
		"check:format": "biome format .",
		"check:architecture": "depcruise src --config .dependency-cruiser.cjs",
		"adr:lint": "node scripts/check-adr.mjs",
		"check": "biome ci . --error-on-warnings && pnpm check:architecture && pnpm adr:lint && pnpm check:complexity",
		"fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json",
		"test": "vitest run --config vitest.config.ts",
		"test:workers": "vitest run --config vitest.workers.config.ts",
		"verify:app": "pnpm check && pnpm typecheck && pnpm test && pnpm test:improvement-agent && pnpm test:quality && pnpm test:workers && pnpm build",
		"verify": "pnpm verify:app && pnpm infra:fmt",
		"hooks:install": "lefthook install",
		"infra:fmt": "terraform -chdir=infra fmt -check -recursive",
		"infra:validate": "terraform -chdir=infra validate",
		"test:improvement-agent": "node --test scripts/improvement-agent/*.test.mjs",
		"check:complexity": "node scripts/check-complexity.mjs",
		"test:quality": "node --test scripts/quality/*.test.mjs"
	},
	"dependencies": {
		"agents": "0.26.0",
		"hono": "4.13.14",
		"openai": "7.45.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@cloudflare/vitest-plugin": "1.4.8",
		"@cloudflare/workers-types": "5.20261026.1",
		"@types/node": "22.19.21",
		"dependency-cruiser": "18.7.0",
		"lefthook": "1.12.4",
		"typescript": "5.9.3",
		"vitest": "4.1.12",
		"wrangler": "4.153.0"
	}
}
